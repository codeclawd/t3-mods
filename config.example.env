# t3-mods configuration (copied to ~/.t3-mods/config.env by `t3-mods install`).

# The T3 Code app to patch. Nightly, Alpha and stable builds all work.
T3_APP="/Applications/T3 Code (Nightly).app"

# T3 patches, applied in order on top of the exact release you have installed.
# Each entry is a .patch file (relative to this repo, or absolute) or a git
# branch as <git url>#<branch>; separate entries with spaces. The bundled patch
# draws Claude Code plugin UI (status lines, toasts, the band above the prompt)
# for any plugin. Add your own patches after it.
T3_PATCHES="patches/claude-plugin-ui.patch"
