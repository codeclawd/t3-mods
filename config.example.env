# t3-mods configuration (copied to ~/.t3-mods/config.env by `t3-mods install`).

# The T3 Code app to patch. Nightly, Alpha and stable builds all work.
T3_APP="/Applications/T3 Code (Nightly).app"

# T3 patch branches, applied in order on top of the exact release you have
# installed. Each entry is <git url>#<branch>; separate entries with spaces.
# The first one draws Claude Code plugin UI (status lines, toasts, the band
# above the prompt) for any plugin. Add your own T3 patches after it.
T3_PATCHES="https://github.com/codeclawd/t3code.git#feat/claude-plugin-ui"
